# Copiar a .env.prod y completar. .env.prod no se sube a Git (ver .gitignore).
# Este archivo solo lleva valores de ejemplo: nunca escriba aquí contraseñas reales.

# Obligatoria. Use una contraseña larga y propia, distinta a la de desarrollo.
DB_PASSWORD=cambiar-esta-contrasena

DB_NAME=avicontrol
DB_USER=avicontrol

# Puerto por el que se publica la aplicación en la máquina (80 en el servidor).
WEB_PORT=80

# Módulo 1: URL base de su REST de solo lectura. Sin ella M3 no sincroniza con M1.
# Ejemplo (IP elástica de M1): M1_BASE_URL=http://18.227.58.143/api/v1
M1_BASE_URL=
# Cada cuánto se consulta a M1 (formato ISO-8601; PT5M = 5 minutos).
SYNC_M1_INTERVALO=PT5M

# Modulo 2: URL base de su REST de integracion con M3. Sin ella M3 no consulta a M2 ni le confirma la utilizacion.
# M2 autoriza a M3 por su IP de salida (52.15.95.91): no hay usuario ni clave.
# Ejemplo (IP elastica de M2): M2_BASE_URL=https://3.21.155.197/api/integracion/modulo3
M2_BASE_URL=
# Cada cuanto se consulta a M2 (formato ISO-8601; PT5M = 5 minutos).
SYNC_M2_INTERVALO=PT5M

# Kafka: el backend no lo usa (el aviso a M2 va por REST). Se conserva solo hasta quitar la dependencia.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# CORS: con nginx reenviando /api el navegador usa un solo origen, así que normalmente no se toca.
# CORS_ORIGENES=http://localhost

# Datos de demostración (galpones y lotes del seed V1000). Descomentar solo para una demo:
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
# FLYWAY_OUT_OF_ORDER=true
